# pixi environments
.pixi/*
!.pixi/config.toml

# Python
__pycache__/
*.pyc
*.egg-info/

# pytest
.pytest_cache/

# mypy
.mypy_cache/

# Run outputs and reference data (regenerated by scripts/select_pka_set.py,
# scripts/select_mnsol_set.py, scripts/run_pka_set.py and
# scripts/run_mnsol_set.py).  The IUPAC and MNSol data are distributed under
# their own licenses, so neither they nor the sets selected from them are
# tracked, including earlier selections and the pKa-labelled structure grids
# select_pka_set.py draws.  The training_set* names are the pKa set's earlier
# ones.
pka_set*.csv
pka_set*.png
training_set*.csv
training_set*.png
mnsol_set.csv
MNSolDatabase*/
train_set/
*_output/
timer.dat

# PCMSolver scratch files (written to the cwd by the Psi4 backend when using PCM)
@pcmsolver.*
PEDRA.OUT*
cavity.off*
cavity.npz
pcmsolver.*.inp*

# Editor / OS
.DS_Store
.idea/
